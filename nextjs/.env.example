# WordPress REST API base (no trailing slash). Requires pretty permalinks (wp-setup enables them).
NEXT_PUBLIC_WP_API_URL=http://localhost:8080/wp-json/lead-capture/v1
# If /wp-json/ still returns HTML, use this instead:
# NEXT_PUBLIC_WP_API_URL=http://localhost:8080/index.php?rest_route=/lead-capture/v1
